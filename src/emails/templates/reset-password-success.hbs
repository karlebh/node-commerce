<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Password Reset Successful</title>
	</head>
	<body
		style="margin: 0; padding: 0; background-color: #f5f5f5; font-family: Arial, sans-serif;"
	>
		<table
			width="100%"
			cellpadding="0"
			cellspacing="0"
			style="padding: 40px 20px;"
		>
			<tr>
				<td align="center">
					<table
						width="100%"
						cellpadding="0"
						cellspacing="0"
						style="max-width: 560px; background-color: #ffffff; border-radius: 8px; padding: 40px;"
					>
						<tr>
							<td>
								<h1 style="margin: 0 0 20px; color: #222222;">
									Password Reset Successful
								</h1>

								<p
									style="margin: 0 0 16px; color: #555555; line-height: 1.6;"
								>
									Hi
									{{username}},
								</p>

								<p
									style="margin: 0 0 16px; color: #555555; line-height: 1.6;"
								>
									Your password has been successfully reset.
								</p>

								<p
									style="margin: 0 0 24px; color: #555555; line-height: 1.6;"
								>
									If you made this change, you don't need to
									do anything else.
								</p>

								<p
									style="margin: 0 0 24px; color: #555555; line-height: 1.6;"
								>
									If you did not reset your password, please
									contact support immediately and secure your
									account.
								</p>

								<p
									style="margin: 0; color: #555555; line-height: 1.6;"
								>
									Thanks,<br />
									<strong>{{appName}}</strong>
								</p>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>