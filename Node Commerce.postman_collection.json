{
  "info": {
    "_postman_id": "b331fba7-6643-4729-aed3-6dd1897f5db7",
    "name": "Node Commerce",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "34356572",
    "description": "Node Commerce API. Set {{BASE_URL}}, run Auth > login to populate {{token}}, then exercise any folder. Several list endpoints capture a first id into a collection variable (productId, categoryId, orderId, userId) so follow-up requests resolve without manual copy/paste."
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate an Idempotency-Key per run if the request needs one.",
          "pm.variables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const token = res.data?.token || res.token;",
                  "if (token) pm.collectionVariables.set('token', token);",
                  "const userId = res.data?.user?.id;",
                  "if (userId) pm.collectionVariables.set('userId', userId);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\",\n    \"password_confirmation\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
