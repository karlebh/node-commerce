NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/node_commerce?schema=public"
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=15m
SESSION_TTL_MS=604800000
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3000
APP_NAME=Node Commerce

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Background jobs
REDIS_URL=redis://localhost:6379

# OAuth (replace placeholders with provider credentials)
OAUTH_SESSION=false
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Email (configure for your SMTP provider)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Node Commerce <no-reply@localhost>"

# Idempotency key retention in milliseconds (default: 24 hours)
IDEMPOTENCY_TTL_MS=86400000

# Payments
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_CALLBACK_URL=http://localhost:5173/payments/callback