{
	"name": "my-backend",
	"version": "1.0.0",
	"description": "A production-minded ecommerce API for learning Node.js with Laravel-inspired structure",
	"main": "dist/index.js",
	"scripts": {
		"dev": "node --watch --import tsx src/index.ts",
		"worker": "tsx src/jobs/scheduler.ts",
		"cli": "tsx src/cli.ts",
		"cli:build": "tsc && node dist/cli.js",
		"build": "tsc",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:studio": "prisma studio"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1137.0",
		"@faker-js/faker": "^10.6.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"bcryptjs": "^3.0.3",
		"bullmq": "^6.3.11",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"handlebars": "^4.7.9",
		"helmet": "^8.3.0",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.4.0",
		"node-cron": "^4.6.0",
		"nodemailer": "^10.0.14",
		"pg": "^8.23.1",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"pino-pretty": "^13.1.3",
		"pino-roll": "^4.0.0",
		"yargs": "^18.2.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.3.0",
		"@types/node": "^22.20.3",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^6.0.3",
		"jest": "^30.5.2",
		"prisma": "^7.10.0",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.14",
		"ts-node-dev": "^2.0.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	},
	"allowScripts": {
		"@prisma/engines@7.10.0": true,
		"prisma@7.10.0": true,
		"esbuild@0.28.2": true,
		"msgpackr-extract@3.0.4": true
	}
}
