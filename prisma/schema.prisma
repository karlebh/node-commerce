generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
    provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  username     String
  email        String    @unique
  passwordHash String?
  products     Product[]
  session      Session[]
    oauthAccounts OAuthAccount[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  images       Image[]
  likes        Like[]
  cart         Cart?
  orders       Order[]
   review      Review[]

  @@map("users")
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  price       Int
  stock       Int       @default(0)
  imageUrl    String?
  isActive    Boolean   @default(true)
  userId      String
  categoryId  String

  user        User      @relation(fields: [userId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])
  review      Review[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([userId])
  @@index([categoryId])
  @@map("products")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("categories")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([email])
  @@map("password_reset_tokens")
}

enum ImageableType {
  POST
  PRODUCT
  CATEGORY
}

model Image {
  id            String        @id @default(cuid())
  userId        String
  url           String
  imageableId   String
  imageableType ImageableType
  size          Int
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([imageableType, imageableId, userId])
  @@unique([imageableType, imageableId, userId])
  @@map("images")
}

model Cart {
  id        String    @id @default(cuid(2))
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String    @id @default(cuid(2))
  cartId    String
  productId String
  quantity  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

enum LikeableType {
  POST
  PRODUCT
}

model Like {
  id           String       @id @default(cuid(2))
  userId       String       
  likeableId   String
  likeableType LikeableType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([likeableId, likeableType, userId])
  @@unique([likeableId, likeableType, userId])
  @@map("likes")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id        String      @id @default(cuid(2))
  userId    String
  status    OrderStatus @default(PENDING)
  total     Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String    @id @default(cuid(2))
  orderId     String
  productId   String
  productName String
  unitPrice   Int
  quantity    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model Review {
  id                 String   @id @default(cuid())
  userId             String
  productId          String
  rating             Int      @db.SmallInt
  title              String?  @db.VarChar(120)
  body               String?  @db.Text
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([productId, isApproved, createdAt])
  @@index([productId, isApproved, rating])
}

enum OauthProviders {
  GOOGLE
  GITHUB
  FACEBOOK
  APPLE
  MICROSOFT
}

model OAuthAccount {
  id   String @id @default(cuid(2))
  provider OauthProviders
  providerAccountId  String
  userId String 
  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}