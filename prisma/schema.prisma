generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
    provider = "postgresql"
}

model User {
  id               String    @id @default(uuid())
  username         String    @unique
  email            String    @unique
  passwordHash     String?
  unsubscribedAt   DateTime?
  unsubscribeToken String    @unique @default(dbgenerated("gen_random_uuid()::text"))
  products         Product[]
  session          Session[]
  oauthAccounts    OAuthAccount[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  images           Image[]
  likes            Like[]
  cart             Cart?
  orders           Order[]
  review           Review[]
  idempotencyKeys  IdempotencyKey[]
  payments         Payment[]
  tasks            Task[]
  newsletterSends  NewsletterSend[]

  @@map("users")
}

model Product {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String
  price       Int
  stock       Int       @default(0)
  imageUrl    String?
  isActive    Boolean   @default(true)
  userId      String
  categoryId  String

  user        User      @relation(fields: [userId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])
  review      Review[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([userId])
  @@index([categoryId])
  @@map("products")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("categories")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([email])
  @@map("password_reset_tokens")
}

enum ImageableType {
  POST
  PRODUCT
  CATEGORY
}

model Image {
  id            String        @id @default(uuid())
  userId        String
  url           String
  imageableId   String
  imageableType ImageableType
  size          Int
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([imageableType, imageableId, userId])
  @@unique([imageableType, imageableId, userId])
  @@map("images")
}

model Cart {
  id        String    @id @default(uuid())
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String    @id @default(uuid())
  cartId    String
  productId String
  quantity  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

enum LikeableType {
  POST
  PRODUCT
}

model Like {
  id           String       @id @default(uuid())
  userId       String       
  likeableId   String
  likeableType LikeableType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([likeableId, likeableType, userId])
  @@unique([likeableId, likeableType, userId])
  @@map("likes")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  status    OrderStatus @default(PENDING)
  total     Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String    @id @default(uuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Int
  quantity    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model Review {
  id                 String   @id @default(uuid())
  userId             String
  productId          String
  rating             Int      @db.SmallInt
  title              String?  @db.VarChar(120)
  body               String?  @db.Text
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([productId, isApproved, createdAt])
  @@index([productId, isApproved, rating])
  @@map("reviews")
}

enum OauthProviders {
  GOOGLE
  GITHUB
  FACEBOOK
  APPLE
  MICROSOFT
}

model OAuthAccount {
  id   String @id @default(uuid())
  provider OauthProviders
  providerAccountId  String
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model IdempotencyKey {
  id             String           @id @default(uuid())
  key            String
  userId         String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  status         IdempotencyStatus
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  expiresAt      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REFUNDED
}

enum LedgerEntryType {
  PAYMENT
  REFUND
  CHARGEBACK
  ADJUSTMENT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

model Payment {
  id                String          @id @default(uuid())
  userId            String
  orderId           String?
  provider          PaymentProvider
  reference         String          @unique
  providerReference String?
  amount            Int
  currency          String          @default("NGN")
  status            PaymentStatus   @default(PENDING)
  rawInit           Json?
  rawVerify         Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id          String          @id @default(uuid())
  provider    PaymentProvider
  eventId     String
  payload     Json
  processedAt DateTime        @default(now())

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

model LedgerEntry {
  id          String          @id @default(uuid())
  userId      String?
  paymentId   String?
  orderId     String?
  type        LedgerEntryType
  direction   LedgerDirection
  amount      Int
  currency    String          @default("NGN")
  reference   String
  description String?
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@unique([type, reference])
  @@index([userId])
  @@index([paymentId])
  @@index([orderId])
  @@map("ledger_entries")
}

model Task {
  id String @id @default(uuid())
  userId String
  title String
  body String @db.Text
  createdAt DateTime @default(now())

user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([title])
  @@map("tasks")
}

model Newsletter {
  id        String    @id @default(uuid())
  slug      String    @unique
  subject   String
  template  String
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  sends NewsletterSend[]

  @@map("newsletters")
}

model NewsletterSend {
  id           String   @id @default(uuid())
  newsletterId String
  userId       String
  sentAt       DateTime @default(now())

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsletterId, userId])
  @@index([userId])
  @@map("newsletter_sends")
}